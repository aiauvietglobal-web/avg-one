{
  "name": "avg-one",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:all": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web && node -e \"const fs = require('fs'); fs.cpSync('apps/web/dist', 'dist', { recursive: true });\"",
    "build:all": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": "20.x"
  }
}