datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RequestType {
  LEAVE
  EXPENSE
  EQUIPMENT
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "3.1 - RDI", "3.2 - THIẾT KẾ", "6 - PHÁP LÝ"
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String?
  avatar       String?
  role         Role        @default(STAFF)
  status       UserStatus  @default(ACTIVE)
  ssoProvider  String?
  ssoId        String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  submittedRequests Request[] @relation("ApplicantRequests")
  approvedRequests  Request[] @relation("ApproverRequests")

  assignedTasks     Task[]    @relation("AssigneeTasks")
  createdTasks      Task[]    @relation("CreatorTasks")

  posts             Post[]
  comments          Comment[]
  goals             Goal[]
  notifications     Notification[]
}

model Request {
  id           String        @id @default(uuid())
  title        String
  type         RequestType   @default(LEAVE)
  description  String?
  amount       Float?
  status       RequestStatus @default(PENDING)
  reason       String?
  
  applicantId  String
  applicant    User          @relation("ApplicantRequests", fields: [applicantId], references: [id], onDelete: Cascade)

  approverId   String?
  approver     User?         @relation("ApproverRequests", fields: [approverId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Task {
  id            String        @id @default(uuid())
  title         String
  description   String?
  orderCode     String?       // Mã đơn hàng (e.g. DH-2026-001)
  orderStatus   String?       @default("THƯỜNG XUYÊN") // THƯỜNG XUYÊN, KHẨN CẤP, TRỌNG ĐIỂM, TỒN, TIỂU DỰ ÁN
  department    String?       @default("3.1 - RDI")     // 3.1 - RDI, 3.2 - THIẾT KẾ, 6 - PHÁP LÝ
  attachmentUrl String?       // Link Google Sheet / URL đính kèm

  status        TaskStatus    @default(TODO)
  priority      TaskPriority  @default(MEDIUM)
  dueDate       DateTime?

  assigneeId    String?
  assignee      User?         @relation("AssigneeTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId     String
  creator       User          @relation("CreatorTasks", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Post {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   @default("THÔNG BÁO") // THÔNG BÁO, CHỈ ĐẠO, VĂN HÓA, TIN TỨC
  isPinned    Boolean  @default(false)
  likesCount  Int      @default(0)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments    Comment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Goal {
  id          String     @id @default(uuid())
  title       String
  description String?
  period      String     @default("Q3-2026") // Q1-2026, Q2-2026, Year 2026...
  progress    Float      @default(0.0)      // 0 to 100%
  status      GoalStatus @default(ON_TRACK)
  type        String     @default("COMPANY") // COMPANY, DEPARTMENT, INDIVIDUAL

  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  keyResults  KeyResult[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model KeyResult {
  id           String   @id @default(uuid())
  title        String
  targetValue  Float
  currentValue Float    @default(0.0)
  unit         String   @default("%")

  goalId       String
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO, REQUEST, TASK, ANNOUNCEMENT
  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}